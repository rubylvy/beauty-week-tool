};

/* ── localStorage keys ──────────────────────────────────────────────────── */
const LS_SCRIPT = 'beautyWeek_scriptUrl';
const LS_SHEET  = 'beautyWeek_sheetUrl';
const LS_DATA   = 'beautyWeek_data';

/* ── Data Persistence ───────────────────────────────────────────────────── */
function saveData() {
  localStorage.setItem(LS_DATA, JSON.stringify(data));
}

function loadData() {
  const saved = localStorage.getItem(LS_DATA);
  if (saved) {
    try {
      const loaded = JSON.parse(saved);
      if (loaded.oneday) Object.assign(data.oneday, loaded.oneday);
      if (loaded.live)   Object.assign(data.live, loaded.live);
    } catch (e) {
      console.error('Failed to load data:', e);
    }
  }
}

