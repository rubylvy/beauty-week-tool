function getSummaryData() {
  const current = data[currentTab];
  const rows = [];
  const section = t  => rows.push({ type: 'section', text: t });
  const row     = (label, value, empty, isLink) =>
    rows.push({ type: 'row', label, value, empty: !!empty, isLink: !!isLink });

  function addBenefit(b, prefix) {
    row(`${prefix} 배너 소구`, str(b.primary), !b.primary.trim());
    b.gifts.forEach((g, i) => {
      const text = formatGift(g, i);
      row(`사은품 ${i + 1}`, text || '—', !text);
      const hasUrl = g.imageUrl && g.imageUrl.trim();
      row(`사은품 ${i + 1} 이미지`, str(g.imageUrl), !hasUrl, !!hasUrl);
    });
    row(`${prefix} 기타 베네핏`, str(b.extra), !b.extra.trim());
    if (prefix === '원데이') {
      row(`${prefix} 유의사항`, str(b.precaution), !b.precaution.trim());
    }
  }

  section('기본 정보');
  row('진행 일자', str(current.campaignDate), !current.campaignDate.trim());
  row('담당 MD',   str(current.mdName),       !current.mdName.trim());
  row('브랜드',    str(current.brand),       !current.brand.trim());
  row('메인이슈',  str(current.mainIssue),   !current.mainIssue.trim());
  row('룩북 링크', str(current.lookbookUrl), !current.lookbookUrl.trim(), !!current.lookbookUrl.trim());
  row('로고 링크', str(current.logoUrl),     !current.logoUrl.trim(),     !!current.logoUrl.trim());

  section('원데이 기획전');
  row('최대 할인율', pct(current.odMax),    !current.odMax.trim());
  row('쿠폰 할인율', pct(current.odCoupon), !current.odCoupon.trim());
  addBenefit(current.odBenefit, '원데이');

  section('일반 기획전');
  row('최대 할인율', pct(current.pgMax),    !current.pgMax.trim());
  row('쿠폰율',      pct(current.pgCoupon), !current.pgCoupon.trim());
  addBenefit(current.pgBenefit, '기획전');

  return rows;
}

