/* ── Helpers ────────────────────────────────────────────────────────────── */
function v(x)   { return (x && x.trim()) ? x.trim() : '?'; }
function vb(b)  { return b && b.primary && b.primary.trim() ? b.primary.trim() : '?'; }
function str(x) { return (x && x.trim()) ? x.trim() : '—'; }
function pct(x) { return (x && x.trim()) ? `${x.trim()}%` : '—'; }

function formatGift(gift, i) {
  const methods = gift.methods || [];
  const isBasic = methods.length === 0;

  if (i === 2) {
    if (!gift.content?.trim() && !gift.item?.trim()) return null;
    if (isBasic) {
      return `${v(gift.content)} 구매 시, ${v(gift.item)} 증정`;
    }
    const distStrs = [];
    if (methods.includes('random')) distStrs.push('랜덤');
    if (methods.includes('first')) {
      distStrs.push(`선착순 ${gift.count && gift.count.trim() ? gift.count.trim() + '명' : '?명'}`);
    }
    return `${v(gift.content)} 구매 시, ${v(gift.item)} ${distStrs.join(' / ')} 증정`;
  }

  if (!gift.amount?.trim() && !gift.item?.trim()) return null;
  if (isBasic) {
    return `${v(gift.amount)}만 원 이상 구매 시, ${v(gift.item)} 증정`;
  }

  const distStrs = [];
  if (methods.includes('random')) distStrs.push('랜덤');
  if (methods.includes('first')) {
    distStrs.push(`선착순 ${gift.count && gift.count.trim() ? gift.count.trim() + '명' : '?명'}`);
  }
  return `${v(gift.amount)}만 원 이상 구매 시, ${v(gift.item)} ${distStrs.join(' / ')} 증정`;
}

function badgeClass(len, limit) {
  if (limit === null) return null;
  if (len >= limit)                  return 'badge-over';
  if (len >= Math.ceil(limit * 0.8)) return 'badge-warn';
  return 'badge-ok';
}

function copyToClipboard(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text);
  }
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0';
  document.body.appendChild(ta);
  ta.focus(); ta.select();
  try { document.execCommand('copy'); } catch (_) {}
  document.body.removeChild(ta);
  return Promise.resolve();
}

function flashBtn(btn, label) {
  btn.textContent = label;
  btn.classList.add('done');
  setTimeout(() => { btn.textContent = btn.dataset.label; btn.classList.remove('done'); }, 1800);
}

