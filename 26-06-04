/* ── Sheet Submit ───────────────────────────────────────────────────────── */
const BANNER_COL_ORDER = [
  '원데이 1탭 배너', '기획전 1탭 배너', '기획전 퀵메뉴', '원데이 PDP 배너',
  '원데이 배너상품조합TC', '원데이 검색화면배너', '기획전 배너상품조합TC',
  'CLP 배너', '기획전 스토어홈배너',
];

function buildSheetPayload() {
  const current = data[currentTab];
  const pct = x => x && x.trim() ? x.trim() + '%' : '';
  const giftStr = (b, i) => formatGift(b.gifts[i], i) || '';

  // 시트 행 순서와 동일하게 배열로 구성
  const columnData = [
    // 기본 정보
    current.campaignDate.trim(),
    current.mdName.trim(),
    current.brand.trim(),
    current.mainIssue.trim(),
    current.lookbookUrl.trim(),
    current.logoUrl.trim(),
    // 원데이 기획전
    pct(current.odMax),
    pct(current.odCoupon),
    current.odBenefit.primary.trim(),
    giftStr(current.odBenefit, 0),
    current.odBenefit.gifts[0].imageUrl.trim(),
    giftStr(current.odBenefit, 1),
    current.odBenefit.gifts[1].imageUrl.trim(),
    giftStr(current.odBenefit, 2),
    current.odBenefit.gifts[2].imageUrl.trim(),
    current.odBenefit.extra.trim(),
    current.odBenefit.precaution.trim(),
    // 일반 기획전
    pct(current.pgMax),
    pct(current.pgCoupon),
    current.pgBenefit.primary.trim(),
    giftStr(current.pgBenefit, 0),
    current.pgBenefit.gifts[0].imageUrl.trim(),
    giftStr(current.pgBenefit, 1),
    current.pgBenefit.gifts[1].imageUrl.trim(),
    giftStr(current.pgBenefit, 2),
    current.pgBenefit.gifts[2].imageUrl.trim(),
    current.pgBenefit.extra.trim(),
  ];

  // 배너 라인들을 개별 행으로 추가
  BANNERS.forEach(banner => {
    if (!banner.lines) {
      columnData.push('');  // 이미지 전용 배너는 빈 값
    } else {
      const lines = banner.lines();
      lines.forEach(line => {
        columnData.push(line.text);
      });
    }
  });

  return {
    sheetUrl:   localStorage.getItem(LS_SHEET) || '',
    brand:      current.brand.trim(),
    tab:        currentTab,
    columnData: columnData,
  };
}

function submitToSheet() {
  const scriptUrl = localStorage.getItem(LS_SCRIPT) || '';
  const sheetUrl  = localStorage.getItem(LS_SHEET)  || '';
  const btn = document.getElementById('btnSend');

  if (!scriptUrl) {
    openSettings();
    return;
  }
  if (!sheetUrl) {
    openSettings();
    return;
  }
  if (!data[currentTab].brand.trim()) {
    alert('브랜드명을 먼저 입력해 주세요.');
    return;
  }

  // sending state
  btn.textContent = '전송 중...';
  btn.className   = 'btn-send sending';
  btn.disabled    = true;

  const payload = buildSheetPayload();

  fetch(scriptUrl, {
    method:  'POST',
    mode:    'no-cors',
    headers: { 'Content-Type': 'text/plain' },
    body:    JSON.stringify(payload),
  })
  .then(() => {
    btn.textContent = '전송 완료';
    btn.className   = 'btn-send success';
    setTimeout(() => {
      btn.textContent = btn.dataset.label;
      btn.className   = 'btn-send';
      btn.disabled    = false;
    }, 2500);
  })
  .catch(() => {
    btn.textContent = '전송 실패';
    btn.className   = 'btn-send error';
    btn.disabled    = false;
    setTimeout(() => {
      btn.textContent = btn.dataset.label;
      btn.className   = 'btn-send';
    }, 2500);
  });
}

document.getElementById('btnSend').setAttribute('data-label', '시트 전송');
document.getElementById('btnSend').onclick = submitToSheet;

