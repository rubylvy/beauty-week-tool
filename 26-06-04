<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>뷰티위크 배너 문구 기획 툴</title>
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.6/dist/web/variable/pretendardvariable.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: "PretendardVariable", "Pretendard", -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 13px;
      color: #111;
      background: #f8f8f8;
    }

    .app { display: flex; height: 100vh; overflow: hidden; }

    /* ── Left Panel ── */
    .panel-left {
      width: 544px;
      flex-shrink: 0;
      background: #fff;
      border-right: 1px solid #ebebeb;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-header {
      padding: 20px 20px 0;
      border-bottom: 1px solid #efefef;
      flex-shrink: 0;
    }

    .panel-title { font-size: 15px; font-weight: 700; color: #111; margin-bottom: 12px; }

    /* ── Tabs ── */
    .tab-buttons {
      display: flex;
      gap: 0;
      margin-bottom: 14px;
    }

    .tab-btn {
      flex: 1;
      padding: 8px 16px;
      border: none;
      background: #f5f5f5;
      border-bottom: 2px solid #ddd;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      color: #888;
      cursor: pointer;
      transition: all 0.12s;
    }

    .tab-btn:first-child { border-right: 1px solid #ddd; }

    .tab-btn:hover { background: #efefef; color: #555; }

    .tab-btn.active {
      background: #fff;
      color: #111;
      border-bottom-color: #707070;
    }

    .brand-form {
      flex: 1;
      overflow-y: auto;
      padding: 14px 20px 24px;
    }

    .brand-form::-webkit-scrollbar { width: 4px; }
    .brand-form::-webkit-scrollbar-track { background: transparent; }
    .brand-form::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }

    .field-group { margin-bottom: 18px; }

    .field-group-title {
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #aaa;
      margin-bottom: 9px;
    }

    .field-item { margin-bottom: 7px; }

    .field-label {
      font-size: 11.5px;
      font-weight: 500;
      color: #555;
      margin-bottom: 3px;
    }

    .field-input {
      width: 100%;
      padding: 6px 9px;
      border: 1.5px solid #e3e3e3;
      border-radius: 5px;
      font-family: inherit;
      font-size: 12.5px;
      color: #111;
      background: #fff;
      outline: none;
      transition: border-color 0.12s;
    }

    .field-input:focus { border-color: #707070; background: #fdfbff; }
    .field-input::placeholder { color: #ccc; }
    .field-input.sm { font-size: 12px; padding: 5px 8px; }

    /* 배너 소구 row with counter */
    .primary-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .primary-row .field-input { flex: 1; }

    .char-counter {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 9px;
      white-space: nowrap;
    }

    .char-counter.cnt-ok   { background: #e5f7ed; color: #1b874a; }
    .char-counter.cnt-warn { background: #fff4e0; color: #c07000; }
    .char-counter.cnt-over { background: #ffebeb; color: #c0392b; }

    /* Benefit block */
    .benefit-block { display: flex; flex-direction: column; }

    .benefit-section-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #bbb;
      margin: 8px 0 5px;
    }

    .benefit-section-label.primary-label { color: #888888; }

    /* Gift block */
    .gift-block {
      border: 1px solid #f0f0f0;
      border-radius: 5px;
      background: #faf9ff;
      padding: 7px 8px 8px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-bottom: 5px;
    }

    .gift-block-label {
      font-size: 10.5px;
      font-weight: 700;
      color: #999999;
      margin-bottom: 2px;
    }

    .gift-row {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .gift-fixed {
      font-size: 11px;
      color: #999;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .gift-amount-input {
      width: 48px;
      flex-shrink: 0;
      padding: 4px 6px;
      border: 1.5px solid #e3e3e3;
      border-radius: 4px;
      font-family: inherit;
      font-size: 12px;
      color: #111;
      outline: none;
      transition: border-color 0.12s;
    }

    .gift-amount-input:focus { border-color: #888888; }
    .gift-amount-input::placeholder { color: #ccc; }

    .gift-flex-input {
      flex: 1;
      min-width: 0;
      padding: 4px 6px;
      border: 1.5px solid #e3e3e3;
      border-radius: 4px;
      font-family: inherit;
      font-size: 12px;
      color: #111;
      outline: none;
      transition: border-color 0.12s;
    }

    .gift-flex-input:focus { border-color: #888888; }
    .gift-flex-input::placeholder { color: #ccc; }

    /* Method toggle */
    .gift-method-row {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 2px;
    }

    .method-btn {
      padding: 2px 8px;
      border-radius: 10px;
      border: 1px solid #e0e0e0;
      background: #f8f8f8;
      font-family: inherit;
      font-size: 10.5px;
      font-weight: 500;
      color: #999;
      cursor: pointer;
      transition: all 0.1s;
    }

    .method-btn.active {
      border-color: #888888;
      background: #efefef;
      color: #555555;
      font-weight: 700;
    }

    .gift-count-input {
      width: 40px;
      padding: 2px 5px;
      border: 1.5px solid #e3e3e3;
      border-radius: 4px;
      font-family: inherit;
      font-size: 11.5px;
      color: #111;
      outline: none;
      transition: border-color 0.12s;
    }

    .gift-count-input:focus { border-color: #888888; }
    .gift-count-input::placeholder { color: #ccc; }

    /* Image link row inside gift block */
    .gift-img-row {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 1px;
    }

    .gift-img-label {
      font-size: 10px;
      color: #bbb;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .gift-img-input {
      flex: 1;
      min-width: 0;
      padding: 3px 6px;
      border: 1.5px solid #ececec;
      border-radius: 4px;
      font-family: inherit;
      font-size: 11px;
      color: #888;
      background: #f3f3f3;
      outline: none;
      transition: border-color 0.12s;
    }

    .gift-img-input:focus { border-color: #888888; background: #fff; color: #333; }
    .gift-img-input::placeholder { color: #ddd; }

    /* ── Right Panel ── */
    .panel-right {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .table-topbar {
      padding: 12px 20px;
      background: #fff;
      border-bottom: 1px solid #ebebeb;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .topbar-title { font-size: 14px; font-weight: 700; color: #111; flex: 1; }

    .btn-action {
      padding: 6px 13px;
      border-radius: 5px;
      border: 1.5px solid #ddd;
      background: #fafafa;
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      color: #555;
      cursor: pointer;
      transition: all 0.12s;
    }

    .btn-action:hover { border-color: #707070; color: #444444; background: #efefef; }
    .btn-action.done  { border-color: #1b874a; color: #1b874a; background: #e5f7ed; }

    .table-wrap {
      flex: 1;
      overflow: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .table-wrap::-webkit-scrollbar { width: 6px; height: 6px; }
    .table-wrap::-webkit-scrollbar-track { background: transparent; }
    .table-wrap::-webkit-scrollbar-thumb { background: #c8c8c8; border-radius: 3px; }

    /* ── Summary Table ── */
    .summary-table {
      border-collapse: separate;
      border-spacing: 0;
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      width: 100%;
    }

    .summary-table .tbl-title {
      padding: 10px 16px;
      background: #f5f5f5;
      font-size: 12px;
      font-weight: 700;
      color: #444;
      border-bottom: 2px solid #d8d8d8;
      border-radius: 7px 7px 0 0;
    }

    .summary-table .section-row td {
      padding: 7px 16px 5px;
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #9898b0;
      background: #f9f9f9;
      border-bottom: 1px solid #f0f0f0;
    }

    .summary-table .data-row td {
      padding: 5px 16px;
      border-bottom: 1px solid #f4f2fb;
      font-size: 12px;
      vertical-align: top;
    }

    .summary-table tr:last-child td { border-bottom: none; }

    .summary-table .row-label {
      width: 140px;
      color: #888;
      font-weight: 500;
      white-space: nowrap;
    }

    .summary-table .row-value       { color: #1a1a2e; }
    .summary-table .row-value.empty { color: #ccc; }
    .summary-table .row-value.link  { color: #707070; font-size: 11px; word-break: break-all; }

    /* ── Banner Copy Table ── */
    .copy-table {
      border-collapse: separate;
      border-spacing: 0;
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      width: 100%;
    }

    .copy-table thead th {
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 10px 16px;
      background: #f5f5f5;
      font-size: 12px;
      font-weight: 700;
      color: #444;
      text-align: left;
      border-bottom: 2px solid #d8d8d8;
    }

    .copy-table thead th.col-type {
      position: sticky;
      left: 0;
      z-index: 20;
      background: #e8e8e8;
      min-width: 148px;
      max-width: 148px;
      border-right: 1px solid #d0d0d0;
    }

    .copy-table thead th.col-copy { min-width: 320px; }

    .copy-table tbody td {
      padding: 12px 16px;
      vertical-align: top;
      border-bottom: 1px solid #f0f0f0;
    }

    .copy-table tbody tr:last-child td { border-bottom: none; }

    .copy-table tbody td.col-type {
      position: sticky;
      left: 0;
      z-index: 5;
      background: #faf9ff;
      min-width: 148px;
      max-width: 148px;
      border-right: 1px solid #eae5f8;
    }

    .copy-table tbody tr:hover td         { background: #fafafa; }
    .copy-table tbody tr:hover td.col-type { background: #f2f2f2; }

    /* 원데이 row accent */
    .copy-table tbody tr.row-oneday td.col-type {
      border-left: 3px solid #8b5cf6;
    }
    .copy-table tbody tr.row-oneday .banner-name { color: #555555; }

    /* 기획전 row accent */
    .copy-table tbody tr.row-promo td.col-type {
      border-left: 3px solid #0ea5e9;
    }
    .copy-table tbody tr.row-promo .banner-name { color: #0369a1; }

    .banner-name { font-size: 12px; font-weight: 700; color: #2a2a3a; margin-bottom: 2px; }
    .banner-sub  { font-size: 10.5px; color: #9898b0; }

    .cell-lines { display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px; }
    .cell-line  { display: flex; align-items: baseline; gap: 5px; }

    .cell-text {
      font-size: 12.5px;
      color: #1a1a2e;
      line-height: 1.5;
      flex: 1;
      word-break: keep-all;
    }

    .badge {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 600;
      padding: 1.5px 5px;
      border-radius: 9px;
      line-height: 1.4;
      white-space: nowrap;
    }

    .badge-ok   { background: #e5f7ed; color: #1b874a; }
    .badge-warn { background: #fff4e0; color: #c07000; }
    .badge-over { background: #ffebeb; color: #c0392b; }

    .no-text-label { font-size: 12px; color: #ccc; font-style: italic; }
    .cell-footer   { display: flex; justify-content: flex-end; }

    .btn-copy {
      padding: 2.5px 8px;
      border-radius: 4px;
      border: 1px solid #ddd;
      background: #fafafa;
      font-family: inherit;
      font-size: 11px;
      font-weight: 500;
      color: #777;
      cursor: pointer;
      transition: all 0.12s;
    }

    .btn-copy:hover  { border-color: #707070; color: #444444; background: #efefef; }
    .btn-copy.copied { border-color: #1b874a; color: #1b874a; background: #e5f7ed; }

    /* ── 시트 전송 버튼 ── */
    .btn-send {
      padding: 6px 14px;
      border-radius: 5px;
      border: 1.5px solid #16a34a;
      background: #16a34a;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      cursor: pointer;
      transition: all 0.12s;
    }
    .btn-send:hover    { background: #15803d; border-color: #15803d; }
    .btn-send:disabled { background: #86efac; border-color: #86efac; color: #fff; cursor: not-allowed; }
    .btn-send.sending  { background: #6ee7b7; border-color: #6ee7b7; color: #065f46; }
    .btn-send.success  { background: #dcfce7; border-color: #16a34a; color: #15803d; }
    .btn-send.error    { background: #fef2f2; border-color: #ef4444; color: #dc2626; }

    /* ── 설정 버튼 ── */
    .btn-settings {
      padding: 6px 11px;
      border-radius: 5px;
      border: 1.5px solid #e0e0e0;
      background: #fafafa;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      color: #888;
      cursor: pointer;
      transition: all 0.12s;
    }
    .btn-settings:hover { border-color: #aaa; color: #555; background: #f4f4f4; }

    /* ── Modal ── */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.35);
      z-index: 100;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }

    .modal-box {
      background: #fff;
      border-radius: 10px;
      padding: 24px 24px 20px;
      width: 420px;
      max-width: calc(100vw - 32px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    }

    .modal-title {
      font-size: 15px;
      font-weight: 700;
      color: #111;
      margin-bottom: 18px;
    }

    .modal-field { margin-bottom: 14px; }

    .modal-label {
      font-size: 11.5px;
      font-weight: 600;
      color: #555;
      margin-bottom: 4px;
    }

    .modal-desc {
      font-size: 10.5px;
      color: #aaa;
      margin-bottom: 5px;
    }

    .modal-input {
      width: 100%;
      padding: 7px 10px;
      border: 1.5px solid #ddd;
      border-radius: 5px;
      font-family: inherit;
      font-size: 12.5px;
      color: #111;
      outline: none;
      transition: border-color 0.12s;
    }
    .modal-input:focus { border-color: #707070; }
    .modal-input::placeholder { color: #ccc; }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px;
    }

    .modal-btn-cancel {
      padding: 7px 14px;
      border-radius: 5px;
      border: 1.5px solid #ddd;
      background: #fafafa;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      color: #777;
      cursor: pointer;
    }
    .modal-btn-cancel:hover { border-color: #aaa; color: #444; }

    .modal-btn-save {
      padding: 7px 16px;
      border-radius: 5px;
      border: 1.5px solid #707070;
      background: #707070;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      cursor: pointer;
    }
    .modal-btn-save:hover { background: #6534f5; border-color: #6534f5; }

    .status-dot {
      display: inline-block;
      width: 7px; height: 7px;
      border-radius: 50%;
      margin-right: 5px;
      vertical-align: middle;
    }
    .status-dot.ok  { background: #16a34a; }
    .status-dot.no  { background: #e5e5e5; }
    .modal-status {
      font-size: 10.5px;
      color: #888;
      margin-top: 6px;
    }

    /* Test Button */
    .btn-test {
      width: 100%;
      padding: 5px 10px;
      margin-bottom: 10px;
      border-radius: 5px;
      border: 1px solid #d0d0d0;
      background: #efefef;
      font-family: inherit;
      font-size: 11px;
      font-weight: 600;
      color: #707070;
      cursor: pointer;
      transition: all 0.12s;
    }
    .btn-test:hover { border-color: #707070; background: #e8d9ff; color: #6534f5; }
  </style>
</head>
<body>
<div class="app">

  <!-- Left Panel -->
  <aside class="panel-left">
    <div class="panel-header">
      <div class="panel-title">뷰티위크 배너 문구 기획</div>
      <div class="tab-buttons">
        <button class="tab-btn active" data-tab="oneday">원데이</button>
        <button class="tab-btn" data-tab="live">라이브</button>
      </div>
    </div>
    <div style="padding: 0 20px; margin-top: 10px;">
      <button class="btn-test" id="btnTestData">테스트 데이터 입력</button>
    </div>
    <div class="brand-form" id="brandForm-oneday"></div>
    <div class="brand-form" id="brandForm-live" style="display:none;"></div>
  </aside>

  <!-- Right Panel -->
  <main class="panel-right">
    <div class="table-topbar">
      <span class="topbar-title">배너별 문구 현황</span>
      <button class="btn-settings" id="btnSettings">설정</button>
      <button class="btn-action" id="btnCsv"  data-label="CSV 복사">CSV 복사</button>
      <button class="btn-action" id="btnJson" data-label="JSON 내보내기">JSON 내보내기</button>
      <button class="btn-send"   id="btnSend" data-label="시트 전송">시트 전송</button>
    </div>
    <div class="table-wrap">
      <table class="summary-table"><tbody id="summaryBody"></tbody></table>
      <table class="copy-table">
        <thead>
          <tr>
            <th class="col-type">배너 타입</th>
            <th class="col-copy">문구</th>
          </tr>
        </thead>
        <tbody id="copyBody"></tbody>
      </table>
    </div>
  </main>
</div>

<!-- Settings Modal -->
<div class="modal-overlay" id="settingsOverlay">
  <div class="modal-box">
    <div class="modal-title">시트 연동 설정</div>

    <div class="modal-field">
      <div class="modal-label">Apps Script 엔드포인트 URL</div>
      <div class="modal-desc">Google Apps Script 배포 후 1회 설정. 이후 변경 불필요.</div>
      <input class="modal-input" id="inputScriptUrl" type="url"
             placeholder="https://script.google.com/macros/s/.../exec">
      <div class="modal-status" id="statusScriptUrl">
        <span class="status-dot no" id="dotScriptUrl"></span>미설정
      </div>
    </div>

    <div class="modal-field">
      <div class="modal-label">구글 시트 URL <span style="font-weight:400;color:#bbb;">(매월 업데이트)</span></div>
      <div class="modal-desc">데이터를 기록할 스프레드시트 URL. 월별로 새 시트로 교체.</div>
      <input class="modal-input" id="inputSheetUrl" type="url"
             placeholder="https://docs.google.com/spreadsheets/d/.../edit">
      <div class="modal-status" id="statusSheetUrl">
        <span class="status-dot no" id="dotSheetUrl"></span>미설정
      </div>
    </div>

    <div class="modal-footer">
      <button class="modal-btn-cancel" id="btnSettingsCancel">취소</button>
      <button class="modal-btn-save"   id="btnSettingsSave">저장</button>
    </div>
  </div>
</div>

<script>
'use strict';

/* ── Data ───────────────────────────────────────────────────────────────── */
const GIFT_MAX = 8; // 배너 소구 글자수 제한

function createDataStructure() {
  return {
    brand: '', mainIssue: '', lookbookUrl: '', logoUrl: '', campaignDate: '', mdName: '',
    odMax: '', odCoupon: '',
    odBenefit: {
      primary: '',
      gifts: [
        { amount: '',  item: '', imageUrl: '', methods: [], count: '' },
        { amount: '',  item: '', imageUrl: '', methods: [], count: '' },
        { content: '', item: '', imageUrl: '', methods: [], count: '' },
      ],
      extra: '',
      precaution: '',
    },
    pgMax: '', pgCoupon: '',
    pgBenefit: {
      primary: '',
      gifts: [
