    row.id = `row-${bi}`;
    if (banner.type) row.className = `row-${banner.type}`;

    const td0 = document.createElement('td');
    td0.className = 'col-type';
    td0.innerHTML = `<div class="banner-name">${banner.name}</div><div class="banner-sub">${banner.sub}</div>`;
    row.appendChild(td0);
    row.appendChild(buildCell(bi));
    tbody.appendChild(row);
  });
}

function buildCell(bi) {
  const banner = BANNERS[bi];
  const td = document.createElement('td');
  td.className = 'col-copy'; td.id = `cell-${bi}`;

  if (!banner.lines) {
    const lbl = document.createElement('span');
    lbl.className = 'no-text-label'; lbl.textContent = '이미지 전용';
    td.appendChild(lbl); return td;
  }

  const lineData = banner.lines();
  const linesDiv = document.createElement('div');
  linesDiv.className = 'cell-lines';

  lineData.forEach(line => {
    const lineEl = document.createElement('div'); lineEl.className = 'cell-line';
    const textEl = document.createElement('span'); textEl.className = 'cell-text'; textEl.textContent = line.text;
    lineEl.appendChild(textEl);
    if (line.limit !== null) {
      const len = line.text.length;
      const badge = document.createElement('span');
      badge.className = `badge ${badgeClass(len, line.limit)}`;
      badge.textContent = `${len}/${line.limit}`;
      lineEl.appendChild(badge);
    }
    linesDiv.appendChild(lineEl);
  });

  td.appendChild(linesDiv);

  const footer = document.createElement('div'); footer.className = 'cell-footer';
  const btn = document.createElement('button'); btn.className = 'btn-copy'; btn.textContent = '복사';
  btn.onclick = () => {
    const text = banner.lines().map(l => l.text).join('\n');
    copyToClipboard(text).then(() => {
      btn.textContent = '복사됨'; btn.classList.add('copied');
      setTimeout(() => { btn.textContent = '복사'; btn.classList.remove('copied'); }, 1500);
    });
  };
  footer.appendChild(btn); td.appendChild(footer);
  return td;
}

/* ── Refresh ────────────────────────────────────────────────────────────── */
function refresh() {
  renderSummary();
  BANNERS.forEach((_, bi) => {
    const row = document.getElementById(`row-${bi}`);
    if (row) row.replaceChild(buildCell(bi), row.cells[1]);
  });
  saveData();
}

/* ── CSV: 내용만, 섹션 구분 포함 ───────────────────────────────────────── */
function generateCSV() {
  const current = data[currentTab];
  const lines = [];

  // 기본 정보
  lines.push('기본 정보');
  if (current.brand.trim())       lines.push(current.brand.trim());
  if (current.mainIssue.trim())   lines.push(current.mainIssue.trim());
  if (current.lookbookUrl.trim()) lines.push(current.lookbookUrl.trim());
  if (current.logoUrl.trim())     lines.push(current.logoUrl.trim());
  lines.push('');

  function addBenefitCSV(b) {
    if (b.primary.trim()) lines.push(b.primary.trim());
    b.gifts.forEach((g, i) => {
      const text = formatGift(g, i);
      if (text) {
        lines.push(text);
        lines.push(g.imageUrl.trim());
      }
    });
    if (b.extra.trim()) lines.push(b.extra.trim());
  }

  // 원데이 기획전
  lines.push('원데이 기획전');
  if (current.odMax.trim())    lines.push(`${current.odMax.trim()}%`);
  if (current.odCoupon.trim()) lines.push(`${current.odCoupon.trim()}%`);
  addBenefitCSV(current.odBenefit);
  lines.push('');

  // 일반 기획전
  lines.push('일반 기획전');
  if (current.pgMax.trim())    lines.push(`${current.pgMax.trim()}%`);
  if (current.pgCoupon.trim()) lines.push(`${current.pgCoupon.trim()}%`);
  addBenefitCSV(current.pgBenefit);
  lines.push('');

  // 배너 문구
  lines.push('배너 문구');
  BANNERS.forEach(banner => {
    if (!banner.lines) return;
    banner.lines().forEach(line => lines.push(line.text));
  });

  return lines.join('\n');
}

/* ── JSON ───────────────────────────────────────────────────────────────── */
function generateJSON() {
  const current = data[currentTab];
  const banners = {};
  BANNERS.forEach(b => { banners[b.name] = b.lines ? b.lines().map(l => l.text) : null; });

  const fmtGifts = (b) => b.gifts.map((g, i) => ({
    text: formatGift(g, i) || '', imageUrl: g.imageUrl || '',
  }));

  return JSON.stringify({
    exportedAt: new Date().toISOString().slice(0, 10),
    brand: current.brand, mainIssue: current.mainIssue,
    lookbookUrl: current.lookbookUrl, logoUrl: current.logoUrl,
    odMax: current.odMax, odCoupon: current.odCoupon,
    odBenefit: { primary: current.odBenefit.primary, gifts: fmtGifts(current.odBenefit), extra: current.odBenefit.extra },
    pgMax: current.pgMax, pgCoupon: current.pgCoupon,
    pgBenefit: { primary: current.pgBenefit.primary, gifts: fmtGifts(current.pgBenefit), extra: current.pgBenefit.extra },
    banners,
  }, null, 2);
}

